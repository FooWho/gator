{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Go App (Prompt for Args)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/gator",
            "args": "${input:getArgs}",
        }
    ],
    "inputs": [
        {
            "id": "getArgs",
            "type": "promptString",
            "description": "Enter your command line arguments:",
            "default": "--flag value positionalArg"
        }
    ]
}